{
  "name": "global-ivf-ams",
  "version": "1.0.0",
  "description": "Attendance Management System (AMS) for Global IVF Hospital",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/src/server.js",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/src/scripts/seed.js"
  },
  "keywords": [
    "ams",
    "attendance",
    "hospital",
    "management",
    "react",
    "express",
    "sqlite"
  ],
  "author": "Global IVF Hospital",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
