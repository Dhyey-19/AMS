{
  "name": "global-ivf-ams",
  "version": "2026.8.21",
  "description": "Attendance Management System (AMS) for Global IVF Hospital",
  "main": "electron/main.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "build:frontend": "node scripts/sync-version.js && npm run build --prefix client",
    "build": "npm run build:frontend",
    "dist": "node scripts/sync-version.js && npm run build && electron-builder && npm run rebuild:node",
    "build:exe": "node scripts/sync-version.js && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npm run dist",
    "server:dev": "node --watch server/src/server.js",
    "client:dev": "npm run dev --prefix client",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run server:dev\" \"npm run dev --prefix client\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "start": "electron .",
    "seed": "node server/src/scripts/seed.js",
    "publish:build": "node scripts/sync-version.js && node server/src/scripts/build-publish.js"
  },
  "keywords": [
    "ams",
    "attendance",
    "hospital",
    "management",
    "react",
    "express",
    "sqlite",
    "electron"
  ],
  "author": "Global IVF Hospital",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^32.2.8",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.globalivf.ams",
    "productName": "Global IVF Hospital AMS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/**/*",
      "data/**/*",
      "build/icon.png",
      "package.json",
      ".env"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Global IVF Hospital AMS"
    }
  },
  "appVersionCode": "20260821"
}
